{
  "name": "cambodia-geo",
  "version": "1.0.0",
  "description": "Lightweight, zero-dependency lookup of Cambodia's provinces, districts, communes and villages (Khmer, English, codes).",
  "license": "MIT",
  "author": "bsthen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsthen/cambodia-geo-js.git"
  },
  "homepage": "https://github.com/bsthen/cambodia-geo-js#readme",
  "bugs": {
    "url": "https://github.com/bsthen/cambodia-geo-js/issues"
  },
  "keywords": [
    "cambodia",
    "khmer",
    "geo",
    "province",
    "district",
    "commune",
    "village",
    "administrative-divisions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "lite": [
        "./dist/lite.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lite": {
      "import": {
        "types": "./dist/lite.d.ts",
        "default": "./dist/lite.js"
      },
      "require": {
        "types": "./dist/lite.d.cts",
        "default": "./dist/lite.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build": "npm run build:data && tsup",
    "typecheck": "npm run build:data && tsc --noEmit",
    "test": "npm run build:data && vitest run",
    "lint:package": "publint --strict && attw --pack . --profile node16",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
